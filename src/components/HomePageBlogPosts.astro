---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PostSummary from "@components/PostSummary.astro";
import { sortCollection } from "@utils/sortCollection";

const blogEntries = await getCollection("posts");

const blogPosts: Array<CollectionEntry<"posts">> = blogEntries;
const blogPostsSorted = sortCollection(blogPosts, "date").slice(0, 3);
---

{
  blogPostsSorted.map((post) => {
    return <PostSummary post={post} />;
  })
}
